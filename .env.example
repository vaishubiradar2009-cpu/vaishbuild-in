# ====================================================================
# MediCare AI - Environment Variables Template
# Copy this file to .env and fill in your actual credentials
# ====================================================================

# 1. Flask Application Settings
FLASK_SECRET_KEY=medicare_ai_super_secret_session_key_2026
FLASK_DEBUG=True
PORT=5000
HOST=0.0.0.0

# 2. Google Gemini AI API Key
# Get a free API key at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash

# 3. Supabase Cloud PostgreSQL Configuration
# Found in: Supabase Dashboard -> Project Settings -> API & Database
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key-here
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key-here

# Supabase Direct PostgreSQL Connection String (Transaction Pooler or Session)
# Found in: Supabase Dashboard -> Project Settings -> Database -> Connection String -> URI
# Format: postgresql://postgres.[project-ref]:[YOUR-PASSWORD]@aws-0-[region].pooler.supabase.com:6543/postgres
SUPABASE_DB_URL=postgresql://postgres.yourprojectid:yourpassword@aws-0-ap-south-1.pooler.supabase.com:6543/postgres

# Note: If Supabase credentials are left empty, the application will automatically
# initialize and run seamlessly with local SQLite (medicare.db)!
